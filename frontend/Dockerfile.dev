# Development Dockerfile for PetHope Frontend

FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install all dependencies (including dev)
RUN npm install

# Copy app files (in dev, this is mounted as volume)
COPY . .

# Expose ports
EXPOSE 3000
EXPOSE 24678

# Environment
ENV NODE_ENV=development
ENV NUXT_HOST=0.0.0.0
ENV NUXT_PORT=3000

# Start dev server with hot reload
CMD ["npm", "run", "dev"]
