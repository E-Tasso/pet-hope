# ========================================
# PetHope - Environment Variables
# ========================================
# Copy this file to .env and adjust values
# cp .env.example .env

# ========================================
# Database (PostgreSQL)
# ========================================
POSTGRES_DB=pethope
POSTGRES_USER=pethope
POSTGRES_PASSWORD=pethope_dev_password_change_me

# ========================================
# Object Storage (MinIO/S3)
# ========================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_change_me
MINIO_BUCKET=pethope-images

# ========================================
# Backend (FastAPI)
# ========================================
# CRITICAL: Change this in production! Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32

# Admin password for initial access
ADMIN_PASSWORD=admin_change_me

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost

# Environment: development, staging, production
ENVIRONMENT=development

# ========================================
# Frontend (Nuxt)
# ========================================
# API base URL (public-facing)
NUXT_PUBLIC_API_BASE=http://localhost/api

# ========================================
# Nginx
# ========================================
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ========================================
# Production Settings (Optional)
# ========================================
# Domain name for SSL certificates
# DOMAIN=pethope.example.com

# Email for Let's Encrypt notifications
# LETSENCRYPT_EMAIL=admin@example.com
